---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="footer section-shell" id="contato">
  <div class="footer__main">
    <div class="footer__brand">
      <a class="brand" href={`${base}/`} aria-label="TEAPOIO — início">
        <img class="brand__logo--full" src={`${base}/teapoio-logo.svg`} alt="TEAPOIO" width="148" height="42" />
      </a>
      <p>Informação clara para famílias da Grande João Pessoa.</p>
    </div>
    <nav class="footer__links" aria-label="Links do rodapé">
      <a href={`${base}/comece-aqui/`}>Comece aqui</a>
      <a href={`${base}/apoio/`}>Apoio perto</a>
      <a href={`${base}/direitos/`}>Direitos</a>
      <a href={`${base}/noticias/`}>Notícias</a>
      <a href={`${base}/faq/`}>Dúvidas frequentes</a>
    </nav>
  </div>
  <div class="footer__bottom">
    <p>O TEAPOIO oferece conteúdo informativo e não substitui atendimento profissional.</p>
    <p>© {year} TEAPOIO</p>
  </div>
</footer>
