---
import news from '../data/news.json';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const isPreview = typeof limit === 'number';
const newsItems = Array.isArray(news.items) ? news.items : [];
const visibleNewsItems = typeof limit === 'number' ? newsItems.slice(0, limit) : newsItems;
const updatedLabel = news.updatedAt
  ? new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short', timeZone: 'America/Sao_Paulo' }).format(new Date(news.updatedAt))
  : null;
const formatDate = (value: string) => new Intl.DateTimeFormat('pt-BR', { dateStyle: 'medium', timeZone: 'America/Sao_Paulo' }).format(new Date(value));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class:list={['news', 'section-shell', isPreview && 'news--preview']} id="noticias" aria-labelledby="news-title">
  <div class="news__heading">
    <div>
      <p class="eyebrow">{isPreview ? 'ATUALIZAÇÕES' : 'NOTÍCIAS SOBRE AUTISMO'}</p>
      <h2 id="news-title">{isPreview ? 'Atualizações recentes.' : 'Notícias nacionais, regionais e locais.'}</h2>
      <p class="section-lede">{isPreview ? 'Duas leituras recentes, sempre com acesso à fonte original.' : 'Publicações reunidas automaticamente e organizadas por abrangência.'}</p>
    </div>
    {!isPreview && (
      <div class="news__tools">
        <label for="news-scope-filter">Mostrar</label>
        <select id="news-scope-filter">
          <option value="Todas">Todas as regiões</option>
          <option value="Nacional">Nacionais</option>
          <option value="Regional">Da Paraíba</option>
          <option value="Local">De João Pessoa</option>
        </select>
      </div>
    )}
  </div>

  {!isPreview && (
    <p class="news-auto-note" aria-live="polite">
      {updatedLabel ? `Atualizado automaticamente em ${updatedLabel}.` : 'A atualização automática será realizada na próxima publicação.'}{' '}
      Os links levam à publicação original.
    </p>
  )}

  {visibleNewsItems.length > 0 ? (
    <div class="news-grid" id="noticias-lista">
      {visibleNewsItems.map((item, index) => (
        <article class:list={['news-card', !isPreview && index === 0 && 'news-card--featured']} data-news-scope={item.scope}>
          <div class="news-card__visual" aria-hidden="true">
            <span>{item.scope === 'Nacional' ? 'BR' : item.scope === 'Regional' ? 'PB' : 'JP'}</span>
            <strong>{item.scope}</strong>
          </div>
          <div class="news-card__body">
            <div class="news-card__meta">
              <span>{item.source}</span>
              <span>{formatDate(item.publishedAt)}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <a class="text-link" href={item.link} target="_blank" rel="noopener noreferrer" aria-label={`Ler notícia: ${item.title}`}>
              Ler notícia original <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <article class="news-card news-card--empty" id="noticias-lista">
      <span class="news-card__number">ATUALIZAÇÃO AUTOMÁTICA</span>
      <h3>As próximas notícias aparecerão aqui.</h3>
      <p>O TEAPOIO busca publicações sobre autismo em fontes nacionais, paraibanas e de João Pessoa sempre que o site é atualizado.</p>
    </article>
  )}

  <p class="filter-status" id="news-filter-status" aria-live="polite"></p>
  {isPreview && (
    <a class="news-more text-link" href={`${base}/noticias/`}>Ver todas as notícias <span aria-hidden="true">→</span></a>
  )}
</section>

<script>
  const newsFilter = document.querySelector<HTMLSelectElement>('#news-scope-filter');
  const newsCards = Array.from(document.querySelectorAll<HTMLElement>('[data-news-scope]'));
  const newsStatus = document.querySelector<HTMLParagraphElement>('#news-filter-status');

  if (newsFilter && newsStatus && newsCards.length > 0) {
    const updateNewsFilter = () => {
      const selectedScope = newsFilter.value;
      let visibleCount = 0;

      newsCards.forEach((card) => {
        const isVisible = selectedScope === 'Todas' || card.dataset.newsScope === selectedScope;
        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      newsStatus.textContent = selectedScope === 'Todas'
        ? `${visibleCount} notícias disponíveis.`
        : `${visibleCount} notícias na categoria ${selectedScope}.`;
    };

    newsFilter.addEventListener('change', updateNewsFilter);
    updateNewsFilter();
  }
</script>
