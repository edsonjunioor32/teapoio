---
import FaqList from './FaqList.astro';
import SiteFooter from './SiteFooter.astro';
---

<section class="faq-section section-shell" id="faq" aria-labelledby="faq-title">
  <div class="faq-section__heading">
    <p class="eyebrow">DÚVIDAS COMUNS</p>
    <h2 id="faq-title">Comece pela pergunta que você já tem.</h2>
  </div>
  <FaqList />
</section>

<section class="final-cta section-shell" id="atualizar" aria-labelledby="cta-title">
  <div>
    <p class="eyebrow">CONSTRUÍDO COM A COMUNIDADE</p>
    <h2 id="cta-title">Uma rede de apoio fica melhor quando a informação circula.</h2>
    <p>Encontrou um contato desatualizado ou um recurso importante? Ajude o TEAPOIO a manter o caminho mais claro.</p>
  </div>
  <a class="button button--primary" href="#contato">Informar uma atualização <span aria-hidden="true">→</span></a>
</section>

<SiteFooter />
