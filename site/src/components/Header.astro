---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { label: 'Comece aqui', path: `${base}/comece-aqui/` },
  { label: 'Encontrar apoio', path: `${base}/apoio/` },
  { label: 'Direitos', path: `${base}/direitos/` },
  { label: 'Notícias', path: `${base}/noticias/` },
  { label: 'Dúvidas frequentes', path: `${base}/faq/` },
];
const normalizePath = (path: string) => path.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={`${base}/`} aria-label="TEAPOIO — página inicial">
      <img class="brand__logo--full brand__logo--reference" src={`${base}/teapoio-reference-logo.jpg`} alt="TEAPOIO" width="2494" height="1696" />
    </a>

    <details class="mobile-nav">
      <summary class="menu-toggle" aria-expanded="false" aria-controls="site-menu" aria-label="Abrir opções que podem lhe ajudar">
        <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="menu-toggle__label">Veja opções que podem lhe ajudar</span>
        <span class="menu-toggle__chevron" aria-hidden="true">⌄</span>
      </summary>

      <nav id="site-menu" aria-label="Navegação principal">
        <p class="mobile-nav__title">Escolha uma opção:</p>
        {links.map((link) => (
          <a href={link.path} aria-current={normalizePath(link.path) === currentPath ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const menuDisclosure = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  const menuToggle = document.querySelector<HTMLElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#site-menu');

  const syncHeaderState = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 12);
  };

  syncHeaderState();
  window.addEventListener('scroll', syncHeaderState, { passive: true });

  if (menuDisclosure && menuToggle && menu) {
    const syncMenuState = () => {
      const isOpen = menuDisclosure.open;
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      menuToggle.setAttribute('aria-label', isOpen ? 'Fechar opções que podem lhe ajudar' : 'Abrir opções que podem lhe ajudar');
      menu.classList.toggle('is-open', isOpen);
      document.body.classList.toggle('menu-is-open', isOpen);
    };

    const closeMenu = () => {
      menuDisclosure.open = false;
      syncMenuState();
    };

    menuDisclosure.addEventListener('toggle', syncMenuState);

    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuDisclosure.open) {
        closeMenu();
        menuToggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!menuDisclosure.open) return;
      if (!(event.target instanceof Element) || !event.target.closest('.site-header')) closeMenu();
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 760) closeMenu();
    });

    syncMenuState();
  }
</script>
