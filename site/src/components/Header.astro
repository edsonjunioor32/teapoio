---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { label: 'Comece aqui', path: `${base}/comece-aqui/` },
  { label: 'Encontrar apoio', path: `${base}/apoio/` },
  { label: 'Lazer', path: `${base}/lazer/` },
  { label: 'Direitos', path: `${base}/direitos/` },
  { label: 'Notícias', path: `${base}/noticias/` },
  { label: 'Dúvidas frequentes', path: `${base}/faq/` },
];
const normalizePath = (path: string) => path.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={`${base}/`} aria-label="TEAPOIO — página inicial">
      <img class="brand__logo--full brand__logo--reference" src={`${base}/teapoio-reference-logo.jpg`} alt="TEAPOIO" width="2494" height="1696" />
    </a>

    <div class="mobile-nav">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Abrir opções que podem lhe ajudar">
        <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="menu-toggle__label">Veja opções que podem lhe ajudar</span>
        <span class="menu-toggle__chevron" aria-hidden="true">⌄</span>
      </button>

      <nav id="site-menu" aria-label="Navegação principal">
        <p class="mobile-nav__title">Escolha uma opção:</p>
        {links.map((link) => (
          <a href={link.path} aria-current={normalizePath(link.path) === currentPath ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const menuDisclosure = document.querySelector<HTMLElement>('.mobile-nav');
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('#site-menu');
  const mobileQuery = window.matchMedia('(max-width: 720px)');

  const syncHeaderState = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 12);
  };

  syncHeaderState();
  window.addEventListener('scroll', syncHeaderState, { passive: true });

  if (menuDisclosure && menuToggle && menu) {
    const syncMenuState = (isOpen = menuDisclosure.classList.contains('is-open')) => {
      const isMobile = mobileQuery.matches;
      const shouldBeOpen = isMobile && isOpen;
      menuDisclosure.classList.toggle('is-open', shouldBeOpen);
      menuToggle.setAttribute('aria-expanded', String(shouldBeOpen));
      menuToggle.setAttribute('aria-label', shouldBeOpen ? 'Fechar opções que podem lhe ajudar' : 'Abrir opções que podem lhe ajudar');
      menu.setAttribute('aria-hidden', String(isMobile && !shouldBeOpen));
      document.body.classList.toggle('menu-is-open', shouldBeOpen);
    };

    const closeMenu = () => {
      syncMenuState(false);
    };

    menuToggle.addEventListener('click', () => {
      syncMenuState(!menuDisclosure.classList.contains('is-open'));
    });

    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menuDisclosure.classList.contains('is-open')) {
        closeMenu();
        menuToggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!menuDisclosure.classList.contains('is-open') || !mobileQuery.matches) return;
      if (!(event.target instanceof Element) || !event.target.closest('.site-header')) closeMenu();
    });

    window.addEventListener('resize', () => syncMenuState(false));

    syncMenuState(false);
  }
</script>

