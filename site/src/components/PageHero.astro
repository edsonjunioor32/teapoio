---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  current: string;
}

const { eyebrow, title, intro, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="page-hero section-shell" aria-labelledby="page-title">
  <nav class="breadcrumbs" aria-label="Trilha de navegação">
    <a href={`${base}/`}>Início</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{current}</span>
  </nav>
  <p class="eyebrow">{eyebrow}</p>
  <h1 id="page-title">{title}</h1>
  <p class="page-hero__intro">{intro}</p>
</section>
