---
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { directoryEntries } from '../../data/directory';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const legalContacts = directoryEntries.filter((entry) => entry.category === 'Orientação jurídica');
const guides = [
  {
    number: '01',
    title: 'CIPTEA e Passe Livre',
    text: 'Consulte documentos, solicitação e acompanhamento na página da FUNAD.',
    action: 'Acessar a FUNAD',
    href: 'https://funad.pb.gov.br/passe-livre',
  },
  {
    number: '02',
    title: 'Escola e inclusão',
    text: 'Conheça a lei que institui a Política Nacional de Proteção dos Direitos da Pessoa com TEA.',
    action: 'Consultar a Lei nº 12.764',
    href: 'https://planalto.gov.br/ccivil_03/_ato2011-2014/2012/lei/l12764.htm',
  },
  {
    number: '03',
    title: 'BPC e assistência social',
    text: 'Confira os critérios, documentos e canais de solicitação no serviço oficial do Gov.br.',
    action: 'Consultar o BPC',
    href: 'https://www.gov.br/pt-br/servicos/solicitar-beneficio-assistencial-a-pessoa-com-deficiencia',
  },
];

const funadRoutes = [
  {
    number: '01',
    title: 'Agendar triagem',
    text: 'O CAD é a porta de entrada informada pela FUNAD para triagem, renovação de laudo e remarcação.',
    action: 'Ver como acessar',
    href: 'https://funad.pb.gov.br/nucleos',
  },
  {
    number: '02',
    title: 'Conhecer o SERI',
    text: 'Serviço especializado que a FUNAD apresenta para pessoas com deficiência intelectual e pessoas com TEA.',
    action: 'Ver serviços para TEA',
    href: 'https://funad.pb.gov.br/assessorias',
  },
  {
    number: '03',
    title: 'Solicitar CIPTEA',
    text: 'Consulte a plataforma, o laudo padrão e os documentos indicados para o pedido online.',
    action: 'Consultar a FUNAD',
    href: 'https://funad.pb.gov.br/passe-livre',
  },
];

const stateRights = [
  {
    title: 'Atenção integral à saúde',
    basis: 'Lei nº 12.764/2012: diagnóstico precoce, atendimento multiprofissional, medicamentos e informações.',
    href: 'https://planalto.gov.br/ccivil_03/_ato2011-2014/2012/lei/l12764.htm',
    action: 'Ler a Lei nº 12.764',
  },
  {
    title: 'CIPTEA e prioridade no atendimento',
    basis: 'Lei nº 13.977/2020: identificação, pronto atendimento e prioridade em serviços públicos e privados.',
    href: 'https://funad.pb.gov.br/passe-livre',
    action: 'Ver CIPTEA na FUNAD',
  },
  {
    title: 'Passe Livre Intermunicipal',
    basis: 'Lei Estadual nº 7.529/2004, conforme legislação reunida pela FUNAD; sujeito a critérios e documentos.',
    href: 'https://funad.pb.gov.br/institucional/legislacoes',
    action: 'Consultar legislação',
  },
  {
    title: 'Habilitação e reabilitação pública',
    basis: 'A FUNAD/CER IV informa atendimento para pessoas com TEA por equipe multidisciplinar em todo o estado.',
    href: 'https://funad.pb.gov.br/a-funad',
    action: 'Conhecer a FUNAD',
  },
];

const joaoPessoaRights = [
  {
    title: 'Passe Livre Municipal',
    basis: 'Lei Municipal nº 7.170/1990, conforme orientação publicada pela FUNAD; confirme residência, estudo/trabalho e documentos exigidos.',
    href: 'https://funad.pb.gov.br/centro',
    action: 'Ver orientação da FUNAD',
  },
  {
    title: 'Diagnóstico e acompanhamento multiprofissional',
    basis: 'Notícia oficial da Prefeitura de João Pessoa cita o CRMIPD e o Centro de Referência Multiprofissional em Doenças Raras.',
    href: 'https://www.joaopessoa.pb.gov.br/noticias/rede-municipal-de-saude-oferece-diagnostico-e-acompanhamento-para-criancas-e-adolescentes-com-autismo/',
    action: 'Ler notícia da Prefeitura',
  },
  {
    title: 'Educação inclusiva e AEE',
    basis: 'Notícia oficial da Prefeitura informa serviços de educação especial e Atendimento Educacional Especializado para pessoas com TEA.',
    href: 'https://www.joaopessoa.pb.gov.br/noticias/prefeitura-disponibiliza-servicos-especializados-para-pessoas-com-transtorno-do-espectro-do-autismo/',
    action: 'Ver orientação educacional',
  },
];

const preparation = [
  'Documento da criança e do responsável, quando solicitado.',
  'CPF e comprovante de residência, conforme o serviço.',
  'Laudo ou relatório profissional, somente quando a página oficial exigir.',
  'Encaminhamento, protocolo e comprovantes de atendimento.',
  'Anotações das dúvidas e o nome do canal que orientou você.',
];
---

<BaseLayout title="Direitos e documentos | TEAPOIO" description="Guias simples para organizar documentos, benefícios e caminhos de inclusão para famílias de pessoas com TEA.">
  <Header />
  <main id="conteudo-principal" tabindex="-1">
    <PageHero eyebrow="DIREITOS E DOCUMENTOS" current="Direitos" title="Acesse o canal certo sem se perder." intro="Escolha o assunto e siga diretamente para a fonte responsável." />

    <section class="page-section section-shell" aria-labelledby="rights-title">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">GUIAS PRIORITÁRIOS</p>
          <h2 id="rights-title">Três caminhos prioritários.</h2>
        </div>
        <p class="section-lede">Regras e documentos podem mudar. Confirme sempre no canal oficial.</p>
      </div>
      <div class="info-grid">
        {guides.map((guide, index) => (
          <article class:list={['info-card', index === 1 && 'info-card--coral']}>
            <span class="info-card__number">{guide.number}</span>
            <h3>{guide.title}</h3>
            <p>{guide.text}</p>
            <a class="text-link" href={guide.href} target="_blank" rel="noopener noreferrer">{guide.action} <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="rights-map section-shell" aria-labelledby="state-rights-title">
      <div class="rights-map__column rights-map__column--state">
        <p class="eyebrow">PARAÍBA</p>
        <h2 id="state-rights-title">É direito do autista na Paraíba ter acesso a:</h2>
        <p class="rights-map__intro">Abaixo estão direitos e caminhos públicos encontrados em leis e fontes institucionais. A aplicação depende do caso, dos critérios e do fluxo de cada serviço.</p>
        <ul class="rights-map__list">
          {stateRights.map((right) => (
            <li class="rights-point">
              <strong class="rights-point__title">{right.title}</strong>
              <span class="rights-point__basis">{right.basis}</span>
              <a class="rights-point__link" href={right.href} target="_blank" rel="noopener noreferrer">{right.action} <span aria-hidden="true">↗</span></a>
            </li>
          ))}
        </ul>
      </div>

      <div class="rights-map__column rights-map__column--city">
        <p class="eyebrow">JOÃO PESSOA</p>
        <h2 id="city-rights-title">É direito do autista em João Pessoa ter acesso a:</h2>
        <p class="rights-map__intro">Aqui estão serviços e caminhos municipais identificados em fontes oficiais. Antes de ir, confirme encaminhamento, endereço, horários e disponibilidade.</p>
        <ul class="rights-map__list" aria-labelledby="city-rights-title">
          {joaoPessoaRights.map((right) => (
            <li class="rights-point">
              <strong class="rights-point__title">{right.title}</strong>
              <span class="rights-point__basis">{right.basis}</span>
              <a class="rights-point__link" href={right.href} target="_blank" rel="noopener noreferrer">{right.action} <span aria-hidden="true">↗</span></a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="page-section section-shell" aria-labelledby="funad-title">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">REFERÊNCIA PÚBLICA NA PARAÍBA</p>
          <h2 id="funad-title">A FUNAD pode ser um próximo passo.</h2>
        </div>
        <p class="section-lede">Ela informa atendimento em habilitação, reabilitação, educação e inclusão para pessoas com TEA. Confirme critérios, documentos e disponibilidade no canal oficial.</p>
      </div>
      <div class="info-grid">
        {funadRoutes.map((route, index) => (
          <article class:list={['info-card', index === 1 && 'info-card--coral']}>
            <span class="info-card__number">{route.number}</span>
            <h3>{route.title}</h3>
            <p>{route.text}</p>
            <a class="text-link" href={route.href} target="_blank" rel="noopener noreferrer">{route.action} <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="page-section section-shell" aria-labelledby="legal-contacts-title">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">CONTATOS INFORMADOS PELO USUÁRIO</p>
          <h2 id="legal-contacts-title">Profissionais para você verificar.</h2>
        </div>
        <p class="section-lede">Os contatos abaixo foram enviados ao TEAPOIO e não representam recomendação, validação ou garantia de resultado. Confirme registro profissional, especialidade, valores, contrato e privacidade diretamente com cada profissional.</p>
      </div>
      <div class="info-grid">
        {legalContacts.map((contact, index) => (
          <article class:list={['info-card', index === 1 && 'info-card--coral']}>
            <span class="info-card__number">CONTATO {String(index + 1).padStart(2, '0')}</span>
            <h3>{contact.name}</h3>
            <p>{contact.description}</p>
            {contact.contact && <a class="text-link" href={contact.contact} target="_blank" rel="noopener noreferrer">{contact.contactLabel ?? 'Contato direto'} <span aria-hidden="true">↗</span></a>}
            {contact.source && <a class="text-link" href={contact.source} target="_blank" rel="noopener noreferrer">{contact.sourceLabel} <span aria-hidden="true">↗</span></a>}
          </article>
        ))}
      </div>
    </section>

    <section class="legal-guidance section-shell" id="orientacao-juridica" aria-labelledby="legal-title">
      <div class="legal-guidance__intro">
        <p class="eyebrow">ORIENTAÇÃO JURÍDICA</p>
        <h2 id="legal-title">Precisa entender um direito ou buscar apoio jurídico?</h2>
        <p>O TEAPOIO não endossa nem valida advogados particulares. Os canais oficiais abaixo ajudam você a buscar orientação adequada para questões de saúde, inclusão e direitos da pessoa com deficiência.</p>
      </div>
      <div class="legal-guidance__links">
        <a class="legal-guidance__link" href="https://defensoria.pb.def.br/saude/" target="_blank" rel="noopener noreferrer">
          <span class="legal-guidance__label">SAÚDE E ACESSO AO SUS</span>
          <strong>Defensoria Pública da Paraíba</strong>
          <span>Consulte o Núcleo Especial de Saúde e as orientações de atendimento.</span>
          <span class="legal-guidance__action">Abrir canal oficial <span aria-hidden="true">↗</span></span>
        </a>
        <div class="legal-guidance__link">
          <span class="legal-guidance__label">DIREITOS DA PESSOA COM DEFICIÊNCIA</span>
          <strong>Comissão da OAB-PB</strong>
          <span>Use o Instagram da Comissão para contato e confira também a página institucional da OAB-PB.</span>
          <div class="legal-guidance__actions">
            <a class="legal-guidance__action" href="https://www.instagram.com/comissaopcd.oabpb/" target="_blank" rel="noopener noreferrer">Falar com a Comissão no Instagram <span aria-hidden="true">↗</span></a>
            <a class="legal-guidance__action" href="https://portal.oabpb.org.br/comissao/comissao-de-defesa-dos-direitos-da-pessoa-com-deficiencia/" target="_blank" rel="noopener noreferrer">Ver página institucional da OAB-PB <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </section>

    <section class="rights-preparation section-shell" aria-labelledby="checklist-title">
      <details>
        <summary id="checklist-title">O que pode ser útil separar antes do atendimento</summary>
        <ul class="check-list">
          {preparation.map((item) => <li>{item}</li>)}
        </ul>
        <p>Esta lista ajuda na organização, mas não substitui as exigências de cada serviço.</p>
      </details>
    </section>

    <section class="privacy-note section-shell" aria-label="Aviso de privacidade">
      <strong>Proteja seus dados.</strong>
      <p>O TEAPOIO não solicita CPF, laudo, receita ou informações sensíveis da criança.</p>
    </section>

    <section class="page-actions section-shell" aria-label="Próximos caminhos">
      <a class="button button--primary" href={`${base}/apoio/`}>Encontrar apoio perto <span aria-hidden="true">→</span></a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
