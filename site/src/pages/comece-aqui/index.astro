---
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const steps = [
  { number: '01', title: 'Observe e anote', text: 'Registre situações do cotidiano, quando começaram e o que ajuda ou dificulta a rotina da criança.' },
  { number: '02', title: 'Procure orientação', text: 'Converse com a Unidade Básica de Saúde ou com um profissional habilitado e leve suas principais dúvidas.' },
  { number: '03', title: 'Organize o próximo passo', text: 'Guarde encaminhamentos e protocolos. Depois, consulte apoio local, escola e direitos conforme a necessidade.' },
];
---

<BaseLayout title="Comece aqui | TEAPOIO" description="Um passo a passo simples para famílias que estão começando a buscar orientação sobre TEA.">
  <Header />
  <main id="conteudo-principal" tabindex="-1">
    <PageHero eyebrow="PRIMEIROS PASSOS" current="Comece aqui" title="Você não precisa resolver tudo hoje." intro="Use este roteiro curto para organizar a dúvida e decidir a primeira ação." />

    <section class="page-section section-shell" aria-labelledby="journey-title">
      <div class="section-heading-row">
        <div>
          <p class="eyebrow">CAMINHO INICIAL</p>
          <h2 id="journey-title">Três passos para começar.</h2>
        </div>
        <p class="section-lede">O TEAPOIO orienta a busca. Avaliação e diagnóstico devem ser realizados por profissionais habilitados.</p>
      </div>

      <ol class="journey-list">
        {steps.map((step) => (
          <li class="journey-card">
            <span class="journey-card__number">{step.number}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="page-actions section-shell" aria-label="Próximos caminhos">
      <a class="button button--primary" href={`${base}/apoio/`}>Encontrar apoio perto <span aria-hidden="true">→</span></a>
      <a class="button button--secondary" href={`${base}/entenda-o-tea/`}>Entender o TEA</a>
      <a class="button button--quiet" href="https://funad.pb.gov.br/nucleos" target="_blank" rel="noopener noreferrer">Agendar triagem na FUNAD <span aria-hidden="true">↗</span></a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
