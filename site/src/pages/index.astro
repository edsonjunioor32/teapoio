---
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import NewsSection from '../components/NewsSection.astro';
import SearchPanel from '../components/SearchPanel.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const paths = [
  {
    number: '01',
    title: 'Não sei por onde começar',
    text: 'Veja um passo a passo curto para organizar dúvidas e buscar orientação.',
    action: 'Ver primeiros passos',
    href: `${base}/comece-aqui/`,
  },
  {
    number: '02',
    title: 'Preciso encontrar um serviço',
    text: 'Pesquise caminhos oficiais e referências locais da Grande João Pessoa.',
    action: 'Buscar apoio perto',
    href: `${base}/apoio/`,
  },
  {
    number: '03',
    title: 'Quero entender direitos',
    text: 'Acesse orientações sobre CIPTEA, Passe Livre, inclusão escolar e BPC.',
    action: 'Ver direitos e documentos',
    href: `${base}/direitos/`,
  },
];
---

<BaseLayout title="TEAPOIO — informação clara para o próximo passo" description="Orientação acolhedora e recursos de apoio para famílias de crianças com TEA na Grande João Pessoa.">
  <Header />
  <main id="conteudo-principal" tabindex="-1">
    <HeroSection />
    <SearchPanel />
    <section class="home-paths section-shell" id="caminhos" aria-labelledby="paths-title">
      <div class="section-heading-row section-heading-row--compact">
        <div>
          <p class="eyebrow">ESCOLHA UMA OPÇÃO</p>
          <h2 id="paths-title">O que você precisa agora?</h2>
        </div>
        <p class="section-lede">Cada opção leva diretamente a uma orientação prática.</p>
      </div>
      <div class="path-grid">
        {paths.map((path) => (
          <a class="path-card" href={path.href}>
            <span class="path-card__number">{path.number}</span>
            <h3>{path.title}</h3>
            <p>{path.text}</p>
            <span class="path-card__action">{path.action} <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </section>
    <NewsSection limit={2} />
  </main>
  <SiteFooter />
</BaseLayout>
